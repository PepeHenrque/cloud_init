#cloud-config

# Atualiza a lista de pacotes antes das instalações
package_update: true

# Cria um usuário administrador
users:
  - name: meu-usuario
    gecos: Administrador DevOps
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMG0oQKjnqhbIuJvm0DDqeW3y3JmD0EGhmBNAJq04AoS meu-usuario@cloud-init-lab

# Instala os softwares declarativamente
packages:
  - docker.io
  - nginx

# Cria uma página personalizada
write_files:
  - path: /var/www/html/index.html
    owner: www-data:www-data
    permissions: "0644"
    content: |
      <!DOCTYPE html>
      <html lang="pt-BR">
      <head>
          <meta charset="UTF-8">
          <meta name="viewport" content="width=device-width, initial-scale=1.0">
          <title>Servidor DevOps - Cloud-Init</title>
          <style>
              * {
                  box-sizing: border-box;
                  margin: 0;
                  padding: 0;
              }
              body {
                  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                  background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
                  color: #f8fafc;
                  display: flex;
                  justify-content: center;
                  align-items: center;
                  min-height: 100vh;
                  padding: 20px;
              }
              .card {
                  background-color: #1e293b;
                  border: 1px solid #334155;
                  border-radius: 16px;
                  padding: 2.5rem;
                  max-width: 650px;
                  width: 100%;
                  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
                  text-align: center;
              }
              .status-dot {
                  display: inline-block;
                  width: 12px;
                  height: 12px;
                  background-color: #22c55e;
                  border-radius: 50%;
                  margin-right: 8px;
                  box-shadow: 0 0 10px #22c55e;
              }
              h1 {
                  color: #38bdf8;
                  margin-bottom: 0.75rem;
                  font-size: 2rem;
              }
              .subtitle {
                  color: #94a3b8;
                  font-size: 1.1rem;
                  margin-bottom: 2rem;
              }
              .badge-container {
                  display: flex;
                  gap: 12px;
                  justify-content: center;
                  flex-wrap: wrap;
                  margin-bottom: 2rem;
              }
              .badge {
                  background-color: #334155;
                  color: #f1f5f9;
                  padding: 0.5rem 1rem;
                  border-radius: 9999px;
                  font-size: 0.875rem;
                  font-weight: 600;
                  border: 1px solid #475569;
              }
              .badge.docker {
                  background-color: #0284c7;
                  border-color: #38bdf8;
              }
              .badge.nginx {
                  background-color: #059669;
                  border-color: #34d399;
              }
              .badge.user {
                  background-color: #7c3aed;
                  border-color: #a78bfa;
              }
              .info-grid {
                  background-color: #0f172a;
                  border-radius: 10px;
                  padding: 1.25rem;
                  text-align: left;
                  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
                  font-size: 0.9rem;
                  border: 1px solid #1e293b;
              }
              .info-row {
                  display: flex;
                  justify-content: space-between;
                  padding: 0.4rem 0;
                  border-bottom: 1px solid #1e293b;
              }
              .info-row:last-child {
                  border-bottom: none;
              }
              .info-label {
                  color: #94a3b8;
              }
              .info-value {
                  color: #38bdf8;
                  font-weight: bold;
              }
              .footer {
                  margin-top: 1.5rem;
                  font-size: 0.8rem;
                  color: #64748b;
              }
          </style>
      </head>
      <body>
          <div class="card">
              <h1><span class="status-dot"></span>Ambiente DevOps Provisionado</h1>
              <p class="subtitle">Configuração concluída via <strong>Cloud-Init</strong> (NoCloud DataSource)</p>
              
              <div class="badge-container">
                  <span class="badge nginx">Nginx Ativo</span>
                  <span class="badge docker">Docker Ativo</span>
                  <span class="badge user">Usuário: meu-usuario</span>
              </div>

              <div class="info-grid">
                  <div class="info-row">
                      <span class="info-label">Hostname:</span>
                      <span class="info-value">servidor-devops</span>
                  </div>
                  <div class="info-row">
                      <span class="info-label">IP Privado:</span>
                      <span class="info-value">192.168.56.10</span>
                  </div>
                  <div class="info-row">
                      <span class="info-label">Porta Web Configurada:</span>
                      <span class="info-value">8080 &rarr; 80 (auto_correct)</span>
                  </div>
                  <div class="info-row">
                      <span class="info-label">Módulo de Arquivos:</span>
                      <span class="info-value">write_files (/var/www/html/index.html)</span>
                  </div>
                  <div class="info-row">
                      <span class="info-label">Autenticação Administrativa:</span>
                      <span class="info-value">SSH Ed25519 + Sudo NOPASSWD</span>
                  </div>
              </div>

              <div class="footer">
                  Provisionado automaticamente via Vagrant & Cloud-Init
              </div>
          </div>
      </body>
      </html>

# Executa comandos após as etapas de configuração
runcmd:
  - systemctl enable --now nginx
  - systemctl enable --now docker
  - usermod -aG docker meu-usuario

# Mensagem final registrada nos logs
final_message: "Cloud-Init finalizou a configuracao com sucesso apos $UPTIME segundos."
